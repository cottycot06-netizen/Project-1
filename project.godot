; Engine configuration file.
; Cosmic Horror — Turn-Based Roguelike (MVP)
; See GAME_NOTES.md for the full design.

config_version=5

[application]

config/name="Cosmic Horror"
config/description="Turn-based cosmic-horror roguelike. MVP: 1-vs-1 combat with HP + Sanity."
run/main_scene="res://scenes/combat/Combat.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
